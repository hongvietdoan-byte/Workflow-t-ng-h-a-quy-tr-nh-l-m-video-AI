# Copy to dashboard.env (ignored by git). Non-secret settings only. Tokens stay in your Windows user environment.
IMAGE_PROVIDER=deepix
VIDEO_PROVIDER=clipai
# AUDIO_PROVIDER follows VIDEO_PROVIDER=clipai when unset
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# CLIPAI_RESOLUTION=1080p
# DASHBOARD_PORT=8501
# Use mock providers to try the app without spending credits:
# IMAGE_PROVIDER=mock
# VIDEO_PROVIDER=mock
# AUDIO_PROVIDER=mock
